generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(cuid())
  clerkId         String?  @unique
  email           String   @unique
  name            String?
  mobile          String?
  profilePhotoUrl String?
  emailVerified   Boolean  @default(false)
  phoneVerified   Boolean  @default(false)
  role            Role     @default(VISITOR)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider  Provider?
  admin     Admin?
  auditLogs AuditLog[]

  @@index([role])
  @@index([email])
  @@index([mobile])
}

enum Role {
  VISITOR
  PROVIDER
  ADMIN
  VERIFICATION_ADMIN
  SUPER_ADMIN
}

model Provider {
  id                        String                      @id @default(cuid())
  userId                    String                      @unique
  user                      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                      String
  mobile                    String?
  email                     String
  profilePhotoUrl           String?
  fatherOrHusbandName       String?
  dateOfBirth               DateTime?
  gender                    String?
  profileType               String?
  address                   String?
  state                     String?
  district                  String?
  tehsil                    String?
  city                      String?
  area                      String?
  pincode                   String?
  categoryId                String?
  category                  Category?                   @relation(fields: [categoryId], references: [id])
  subCategoryId             String?
  subCategory               SubCategory?                @relation(fields: [subCategoryId], references: [id])
  specialization            String?
  services                  String[]                    @default([])
  highestQualification      String?
  professionalQualification String?
  professionalMembership    String?
  awards                    String?
  industriesServed          String?
  experienceYears           Int?
  languages                 String[]                    @default([])
  availability              String[]                    @default([])
  workingDays               String[]                    @default([])
  officeTiming              String?
  officeName                String?
  officeAddress             String?
  officeLandmark            String?
  googleMapLocation         String?
  registrationNumber        String?
  registrationAuthority     String?
  registrationValidity      String?
  serviceAreas              String[]                    @default([])
  feeType                   String?
  minimumFee                Int?
  maximumFee                Int?
  bankName                  String?
  bankAccountNumber         String?
  bankIfsc                  String?
  upiId                     String?
  websiteUrl                String?
  googleBusinessUrl         String?
  facebookUrl               String?
  instagramUrl              String?
  linkedinUrl               String?
  youtubeUrl                String?
  bio                       String?
  declarationAcceptedAt     DateTime?
  status                    ProviderStatus              @default(DRAFT)
  verificationLevel         VerificationLevel           @default(NOT_VERIFIED)
  verifiedAt                DateTime?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  documents                 ProviderDocument[]
  verificationRequests      VerificationRequest[]
  serviceOfferings          ProviderServiceOffering[]
  leads                     Lead[]
  bookings                  Booking[]
  messageThreads            MessageThread[]
  notifications             ProviderNotification[]
  reviews                   ProviderReview[]
  subscriptions             ProviderSubscription[]
  analyticsSnapshots        ProviderAnalyticsSnapshot[]
  supportTickets            SupportTicket[]
  tasks                     ProviderTask[]

  @@index([status])
  @@index([city])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([email])
  @@index([mobile])
  @@index([state])
  @@index([district])
}

enum ProviderStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  NEEDS_MORE_DOCUMENTS
}

enum VerificationLevel {
  NOT_VERIFIED
  BASIC_VERIFIED
  PROFESSIONAL_VERIFIED
  KAUNBATAYEGA_VERIFIED @map("BHAROSA_HAI_VERIFIED")
  KAUNBATAYEGA_TRUSTED  @map("BHAROSA_HAI_TRUSTED")
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  slug          String        @unique
  description   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  providers     Provider[]
  subCategories SubCategory[]
  services      Service[]

  @@index([slug])
}

model SubCategory {
  id         String     @id @default(cuid())
  name       String
  slug       String
  categoryId String
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  providers  Provider[]
  services   Service[]

  @@unique([categoryId, name])
  @@unique([categoryId, slug])
  @@index([slug])
}

model Service {
  id            String                    @id @default(cuid())
  name          String
  slug          String
  categoryId    String
  category      Category                  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategoryId String?
  subCategory   SubCategory?              @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  offerings     ProviderServiceOffering[]

  @@unique([categoryId, slug])
  @@index([slug])
  @@index([subCategoryId])
}

model ProviderDocument {
  id               String         @id @default(cuid())
  providerId       String
  provider         Provider       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  documentType     String
  fileName         String
  originalFileName String?
  storagePath      String
  fileSize         Int?
  mimeType         String?
  status           DocumentStatus @default(PENDING)
  uploadedAt       DateTime       @default(now())
  reviewedAt       DateTime?
  verified         Boolean        @default(false)

  @@index([providerId])
  @@index([documentType])
  @@index([status])
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProviderServiceOffering {
  id              String                @id @default(cuid())
  providerId      String
  provider        Provider              @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceId       String?
  service         Service?              @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  title           String
  slug            String
  description     String?
  pricingType     String?
  minimumPrice    Int?
  maximumPrice    Int?
  experienceYears Int?
  cities          String[]              @default([])
  availability    String[]              @default([])
  status          ServiceOfferingStatus @default(ENABLED)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([providerId, slug])
  @@index([providerId, status])
  @@index([serviceId])
}

enum ServiceOfferingStatus {
  ENABLED
  DISABLED
}

model Lead {
  id             String           @id @default(cuid())
  providerId     String
  provider       Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customerName   String
  customerEmail  String?
  customerMobile String?
  serviceTitle   String
  budgetMin      Int?
  budgetMax      Int?
  location       String?
  message        String?
  source         String           @default("customer-portal")
  status         LeadStatus       @default(NEW)
  lastActionAt   DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  bookings       Booking[]
  messageThreads MessageThread[]
  reviews        ProviderReview[]

  @@index([providerId, status])
  @@index([providerId, createdAt])
}

enum LeadStatus {
  NEW
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Booking {
  id             String           @id @default(cuid())
  providerId     String
  provider       Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerName   String
  customerMobile String?
  serviceTitle   String
  address        String?
  notes          String?
  status         BookingStatus    @default(UPCOMING)
  scheduledAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  messageThreads MessageThread[]
  reviews        ProviderReview[]

  @@index([providerId, status])
  @@index([providerId, scheduledAt])
  @@index([leadId])
}

enum BookingStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
  RESCHEDULED
}

model MessageThread {
  id             String              @id @default(cuid())
  providerId     String
  provider       Provider            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  bookingId      String?
  booking        Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customerName   String
  customerMobile String?
  subject        String
  status         MessageThreadStatus @default(OPEN)
  unreadCount    Int                 @default(0)
  lastMessageAt  DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  messages       Message[]

  @@index([providerId, status])
  @@index([providerId, lastMessageAt])
  @@index([leadId])
  @@index([bookingId])
}

enum MessageThreadStatus {
  OPEN
  CLOSED
}

model Message {
  id            String        @id @default(cuid())
  threadId      String
  thread        MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderRole    String
  body          String
  attachmentUrl String?
  readAt        DateTime?
  createdAt     DateTime      @default(now())

  @@index([threadId, createdAt])
}

model ProviderNotification {
  id         String           @id @default(cuid())
  providerId String
  provider   Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  type       NotificationType @default(INFO)
  title      String
  body       String
  href       String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([providerId, readAt])
  @@index([providerId, createdAt])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model ProviderReview {
  id           String       @id @default(cuid())
  providerId   String
  provider     Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  leadId       String?
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  bookingId    String?
  booking      Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customerName String
  rating       Int
  comment      String?
  response     String?
  responseAt   DateTime?
  status       ReviewStatus @default(PUBLISHED)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([providerId, status])
  @@index([providerId, rating])
  @@index([leadId])
  @@index([bookingId])
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  REPORTED
}

model ProviderSubscription {
  id           String             @id @default(cuid())
  providerId   String
  provider     Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  planName     String
  status       SubscriptionStatus @default(ACTIVE)
  priceMonthly Int?
  benefits     Json?
  startedAt    DateTime           @default(now())
  renewsAt     DateTime?
  expiresAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([providerId, status])
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  EXPIRED
}

model ProviderAnalyticsSnapshot {
  id                  String   @id @default(cuid())
  providerId          String
  provider            Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  date                DateTime
  profileViews        Int      @default(0)
  searchAppearances   Int      @default(0)
  leadConversionRate  Int      @default(0)
  responseTimeMinutes Int      @default(0)
  revenueAmount       Int      @default(0)
  completedJobs       Int      @default(0)
  createdAt           DateTime @default(now())

  @@unique([providerId, date])
  @@index([providerId, date])
}

model ProviderTask {
  id          String       @id @default(cuid())
  providerId  String
  provider    Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  title       String
  notes       String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(PENDING)
  dueAt       DateTime?
  completedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([providerId, status])
  @@index([providerId, dueAt])
  @@index([providerId, deletedAt])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  COMPLETED
}

model SupportTicket {
  id         String              @id @default(cuid())
  providerId String
  provider   Provider            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  subject    String
  category   String?
  priority   String              @default("NORMAL")
  status     SupportTicketStatus @default(OPEN)
  message    String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([providerId, status])
  @@index([providerId, createdAt])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model VerificationRequest {
  id         String             @id @default(cuid())
  providerId String
  provider   Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  status     VerificationStatus @default(PENDING)
  message    String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([providerId])
  @@index([status])
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_MORE_DOCUMENTS
}

model Admin {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}
